generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum HardwareStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  LOST
  RETIRED
}

enum RentStatus {
  PENDING_PAYMENT
  CONFIRMED
  ACTIVE
  RETURNED
  OVERDUE
  CANCELLED
}

enum PaymentGateway {
  MIDTRANS
  XENDIT
  MOCK
}

enum TransactionStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

enum IssueCategory {
  NO_SIGNAL
  BATTERY_FAILURE
  PHYSICAL_DAMAGE
  LOST_UNIT
  OTHER
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  phone        String?
  role         Role          @default(CUSTOMER)
  rents        Rent[]
  issueTickets IssueTicket[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([role])
}

model HardwareAsset {
  id            String         @id @default(cuid())
  serialNumber  String         @unique
  imei          String         @unique
  model         String
  batteryHealth Int            @default(100)
  speed         String
  dailyRate     Decimal        @db.Decimal(12, 2)
  status        HardwareStatus @default(AVAILABLE)
  rents         Rent[]
  issueTickets  IssueTicket[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([model])
}

model Rent {
  id            String         @id @default(cuid())
  rentalCode    String         @unique
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  hardwareId    String?
  hardware      HardwareAsset? @relation(fields: [hardwareId], references: [id], onDelete: SetNull)
  destination   String
  startDate     DateTime
  endDate       DateTime
  totalDays     Int
  dailyRate     Decimal        @db.Decimal(12, 2)
  depositAmount Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal        @db.Decimal(12, 2)
  status        RentStatus     @default(PENDING_PAYMENT)
  transactions  Transaction[]
  issueTickets  IssueTicket[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([hardwareId])
  @@index([status])
  @@index([startDate, endDate])
}

model Transaction {
  id            String            @id @default(cuid())
  rentId        String
  rent          Rent              @relation(fields: [rentId], references: [id], onDelete: Cascade)
  gatewayRef    String?           @unique
  gateway       PaymentGateway    @default(MIDTRANS)
  paymentMethod String?
  amount        Decimal           @db.Decimal(12, 2)
  status        TransactionStatus @default(PENDING)
  snapToken     String?
  paidAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([rentId])
  @@index([status])
  @@index([gatewayRef])
}

model IssueTicket {
  id              String         @id @default(cuid())
  ticketCode      String         @unique
  rentId          String
  rent            Rent           @relation(fields: [rentId], references: [id], onDelete: Cascade)
  hardwareId      String?
  hardware        HardwareAsset? @relation(fields: [hardwareId], references: [id], onDelete: SetNull)
  reporterId      String
  reporter        User           @relation(fields: [reporterId], references: [id])
  category        IssueCategory  @default(OTHER)
  priority        IssuePriority  @default(MEDIUM)
  subject         String
  description     String         @db.Text
  status          IssueStatus    @default(OPEN)
  resolutionNotes String?        @db.Text
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([rentId])
  @@index([hardwareId])
  @@index([reporterId])
  @@index([status])
  @@index([priority])
}
