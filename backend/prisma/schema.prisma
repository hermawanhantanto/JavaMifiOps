generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum DeviceStatus {
  AVAILABLE
  BOOKED
  RENTED
  MAINTENANCE
  LOST
  RETIRED
}

enum DeviceSpeed {
  SPEED_4G_150MBPS
  SPEED_4G_300MBPS
  SPEED_5G_500MBPS
  SPEED_5G_1GBPS
}

enum RentalStatus {
  PENDING_PAYMENT
  CONFIRMED
  ACTIVE
  RETURNED
  OVERDUE
  CANCELLED
}

enum PaymentGateway {
  MIDTRANS
  XENDIT
  MOCK
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

enum FulfillmentType {
  AIRPORT_PICKUP
  HOME_DELIVERY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  phone        String?
  address      String?
  role         Role      @default(CUSTOMER)
  rentals      Rental[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@map("users")
}

model Device {
  id            String       @id @default(cuid())
  serialNumber  String       @unique
  imei          String       @unique
  model         String
  batteryHealth Int          @default(100)
  speed         DeviceSpeed
  dailyRate     Decimal      @db.Decimal(12, 2)
  status        DeviceStatus @default(AVAILABLE)
  rentals       Rental[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([model])
  @@map("devices")
}

model Rental {
  id              String          @id @default(cuid())
  rentalCode      String          @unique
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  deviceId        String?
  device          Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  destination     String
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  totalAmount     Decimal         @db.Decimal(12, 2)
  status          RentalStatus    @default(PENDING_PAYMENT)
  fulfillmentType FulfillmentType @default(AIRPORT_PICKUP)
  pickupLocation  String?
  shippingAddress String?
  trackingNumber  String?
  expiresAt       DateTime?
  payments        Payment[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@index([fulfillmentType])
  @@index([expiresAt])
  @@index([startDate, endDate])
  @@map("rentals")
}

model Payment {
  id            String         @id @default(cuid())
  rentalId      String
  rental        Rental         @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  gatewayRef    String?        @unique
  gateway       PaymentGateway @default(MIDTRANS)
  paymentMethod String?
  amount        Decimal        @db.Decimal(12, 2)
  status        PaymentStatus  @default(PENDING)
  snapToken     String?
  redirectUrl   String?
  paidAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  webhookLogs   PaymentWebhookLog[]

  @@index([rentalId])
  @@index([status])
  @@index([gatewayRef])
  @@map("payments")
}

model PaymentWebhookLog {
  id                String       @id @default(cuid())
  paymentId         String?
  payment           Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  orderId           String
  transactionId     String?
  transactionStatus String?
  fraudStatus       String?
  statusCode        String?
  grossAmount       Decimal?     @db.Decimal(12, 2)
  signatureKey      String?
  isSignatureValid  Boolean      @default(false)
  isProcessed       Boolean      @default(false)
  failureReason     String?
  rawPayload        Json
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([orderId])
  @@index([transactionId])
  @@index([paymentId])
  @@index([isProcessed])
  @@map("payment_webhook_logs")
}
