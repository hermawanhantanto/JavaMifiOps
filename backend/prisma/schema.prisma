generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum DeviceStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  LOST
  RETIRED
}

enum DeviceSpeed {
  SPEED_4G_150MBPS
  SPEED_4G_300MBPS
  SPEED_5G_500MBPS
  SPEED_5G_1GBPS
}

enum RentalStatus {
  PENDING_PAYMENT
  CONFIRMED
  ACTIVE
  RETURNED
  OVERDUE
  CANCELLED
}

enum PaymentGateway {
  MIDTRANS
  XENDIT
  MOCK
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

enum TicketCategory {
  NO_SIGNAL
  BATTERY_FAILURE
  PHYSICAL_DAMAGE
  LOST_UNIT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  phone        String?
  role         Role      @default(CUSTOMER)
  rentals      Rental[]
  tickets      Ticket[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@map("users")
}

model Device {
  id            String       @id @default(cuid())
  serialNumber  String       @unique
  imei          String       @unique
  model         String
  batteryHealth Int          @default(100)
  speed         DeviceSpeed
  dailyRate     Decimal      @db.Decimal(12, 2)
  status        DeviceStatus @default(AVAILABLE)
  rentals       Rental[]
  tickets       Ticket[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([model])
  @@map("devices")
}

model Rental {
  id            String       @id @default(cuid())
  rentalCode    String       @unique
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  deviceId      String?
  device        Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  destination   String
  startDate     DateTime
  endDate       DateTime
  totalDays     Int
  dailyRate     Decimal      @db.Decimal(12, 2)
  depositAmount Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal      @db.Decimal(12, 2)
  status        RentalStatus @default(PENDING_PAYMENT)
  payments      Payment[]
  tickets       Ticket[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("rentals")
}

model Payment {
  id            String         @id @default(cuid())
  rentalId      String
  rental        Rental         @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  gatewayRef    String?        @unique
  gateway       PaymentGateway @default(MIDTRANS)
  paymentMethod String?
  amount        Decimal        @db.Decimal(12, 2)
  status        PaymentStatus  @default(PENDING)
  snapToken     String?
  paidAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([rentalId])
  @@index([status])
  @@index([gatewayRef])
  @@map("payments")
}

model Ticket {
  id              String         @id @default(cuid())
  ticketCode      String         @unique
  rentalId        String
  rental          Rental         @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  deviceId        String?
  device          Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  reporterId      String
  reporter        User           @relation(fields: [reporterId], references: [id])
  category        TicketCategory @default(OTHER)
  priority        TicketPriority @default(MEDIUM)
  subject         String
  description     String         @db.Text
  status          TicketStatus   @default(OPEN)
  resolutionNotes String?        @db.Text
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([rentalId])
  @@index([deviceId])
  @@index([reporterId])
  @@index([status])
  @@index([priority])
  @@map("tickets")
}
